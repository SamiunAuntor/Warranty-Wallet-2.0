# Backend API. Leave empty during development to reuse the Expo dev server's
# host on port 5000. Set it explicitly for builds, for example:
# EXPO_PUBLIC_API_URL=https://warranty-wallet-2-0.vercel.app/api/v1
EXPO_PUBLIC_API_URL=

# Same Firebase web app as frontend/.env.local
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. The Google button only appears when the current platform has an ID.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
