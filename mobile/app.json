{
  "expo": {
    "name": "Warranty Wallet",
    "slug": "warranty-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "warrantywallet",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "android": {
      "package": "com.warrantywallet.app"
    },
    "ios": {
      "bundleIdentifier": "com.warrantywallet.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
